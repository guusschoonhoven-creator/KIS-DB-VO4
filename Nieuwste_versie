function renderDisciplineOptions(){disciplineSelect.innerHTML="";const keys=accessibleDisciplineKeys();keys.forEach(k=>{const o=document.createElement("option");o.value=k;o.textContent=disciplines[k].label;disciplineSelect.appendChild(o)});if(!keys.includes(currentDiscipline))currentDiscipline=keys[0];const broad=currentUser.loginKey==="huisarts"||currentUser.loginKey==="longarts";disciplineSelect.style.display=broad?"block":"none";disciplineLabel.style.display=broad?"block":"none";disciplineLabel.textContent=currentUser.loginKey==="longarts"?"Specialistische discipline":"Discipline"}
function renderPatientOptions(){patientSelect.innerHTML="";Object.entries(patients).forEach(([id,p])=>{const o=document.createElement("option");o.value=id;o.textContent=`${p.shortName} — ${p.diagnosis}`;patientSelect.appendChild(o)});patientSelect.value=currentPatientId}
function renderPatientHeader(){const p=activePatient();patientSelect.value=currentPatientId;patientCard.innerHTML=`<div><strong>Patiënt:</strong> ${p.fullName}</div><div><strong>${p.sexAge}</strong></div><div><strong>BSN:</strong> ${p.bsn}</div><div><strong>Diagnose:</strong> ${p.diagnosis}</div><div><strong>Allergie:</strong> ${p.allergy}</div>`;patientAlert.innerHTML=`⚠ <strong>Actuele signalering:</strong> ${p.alert}`}
function getPatientDisciplineData(key){const p=activePatient(),m=p.metrics,high=p.diagnosis.includes("IV"),mild=p.diagnosis.includes("II");const h={huisarts:[`Controle ${p.shortName} — patiëntgegevens beoordeeld`,`Follow-up COPD en risicosignalen vastgelegd`,`Overdracht vanuit ketenteam bekeken`],longzorg:[`Longfunctie ${m.fev1} en SpO₂ ${m.spo2} beoordeeld`,`Exacerbatie-risico besproken`,`Behandeladvies afgestemd met ketenteam`],verpleegkundigen:[`Verpleegkundige observatie bij ${p.shortName} bijgewerkt`,`Gordon-opzet en zorgplan gecontroleerd`,`Overdracht en open acties afgestemd`],fysiotherapie:[`6MWT geregistreerd: ${m.sixmwt}`,`Belastbaarheid beoordeeld`,`Beweegplan geëvalueerd`],dietetiek:[`Gewicht geregistreerd: ${m.weight}`,`BMI beoordeeld: ${m.bmi}`,`Voedingsrisico en intake besproken`],psychologie:[`Coping beoordeeld: ${m.coping}`,`Angst bij benauwdheid: ${m.anxiety}`,`Zelfmanagement en steun besproken`]};return{huisarts:{role:"Totaaloverzicht, signalering, verwijzing en follow-up",cards:[["FEV1",m.fev1],["SpO₂",m.spo2],["Exacerbaties",m.exacerbations],["Diagnose",p.diagnosis]],history:h.huisarts},longzorg:{role:"Diagnose, stadiëring en specialistisch behandeladvies",cards:[["FEV1",m.fev1],["SpO₂",m.spo2],["Exacerbaties",m.exacerbations],["Behandeladvies","Herbeoordeling op basis van actuele waarden"]],history:h.longzorg},verpleegkundigen:{role:"Zorgcoördinatie, observatie, Gordon-opzet, signalering en overdracht",cards:[["Gordon-opzet","Beschikbaar"],["Zorgplan","Patiëntspecifiek"],["Risicosignalen",p.alert],["Overdracht","Multidisciplinair delen"]],history:h.verpleegkundigen},fysiotherapie:{role:"Longrevalidatie, belastbaarheid en bewegen",cards:[["6MWT",m.sixmwt],["MRC-score",high?"4/5":mild?"2/5":"3/5"],["Beweegdoel","Veilig opbouwen"],["Status","Longrevalidatie volgen"]],history:h.fysiotherapie},dietetiek:{role:"Voedingstoestand en gewichtsverloop",cards:[["Gewicht",m.weight],["BMI",m.bmi],["Voedingsrisico",high?"Hoog":mild?"Laag-matig":"Matig"],["Advies","Voedingsstatus vervolgen"]],history:h.dietetiek},psychologie:{role:"Coping, angst en psychosociale ondersteuning",cards:[["Coping",m.coping],["Angst",m.anxiety],["Zelfmanagement",high?"Extra ondersteuning gewenst":"Ondersteuning volgen"],["Mantelzorg","Betrekken waar nodig"]],history:h.psychologie}}[key]}
function roleTaskOwners(){if(currentUser.loginKey==="huisarts")return["Huisarts","Longarts","Longzorg","Verpleegkundigen","Fysiotherapie","Diëtetiek","Psychologie"];if(currentUser.loginKey==="longarts")return["Longarts","Longzorg","Verpleegkundigen","Fysiotherapie","Diëtetiek","Psychologie"];return[currentUser.taskOwner]}
function taskVisibleForCurrentUser(t){return roleTaskOwners().includes(t[0])&&t[4]===currentPatientId}
function render(){renderPatientHeader();sideRole.textContent=currentUser.role;sideAccess.textContent=currentUser.access;loginStatus.innerHTML=`${currentUser.name} — <strong>${currentUser.role}</strong>`;document.querySelectorAll(".sidebar button[data-tab]").forEach(b=>{const tab=b.dataset.tab;b.style.display=currentUser.tabs.includes(tab)?"block":"none";b.classList.toggle("active",tab===currentTab)});if(!currentUser.tabs.includes(currentTab))currentTab="overzicht";if(currentUser.loginKey!=="huisarts"&&currentUser.loginKey!=="longarts")currentDiscipline=currentUser.discipline;disciplineSelect.value=currentDiscipline;if(currentTab==="overzicht")renderOverview();if(currentTab==="acties")renderActionsCommunication();if(currentTab==="dossier")renderDossier();if(currentTab==="gordon")renderGordon();if(currentTab==="nood")renderEmergency()}
function panel(t,c){mainPanel.innerHTML=`<section class="panel"><h2>${t}</h2>${c}</section>`}function esc(t){return String(t).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")}
function line(labels,values,o={}){const w=260,h=120,p={top:12,right:12,bottom:24,left:28},iw=w-p.left-p.right,ih=h-p.top-p.bottom,min=o.min??Math.min(...values),max=o.max??Math.max(...values),safe=max===min?max+1:max,step=values.length>1?iw/(values.length-1):iw,x=i=>p.left+i*step,y=v=>p.top+ih-((v-min)/(safe-min))*ih,pts=values.map((v,i)=>`${x(i)},${y(v)}`).join(" "),area=`${p.left},${p.top+ih} ${pts} ${p.left+iw},${p.top+ih}`,grid=[0,.5,1].map(r=>`<line x1="${p.left}" y1="${p.top+ih*r}" x2="${p.left+iw}" y2="${p.top+ih*r}" stroke="#e2e8f0"/>`).join(""),dots=values.map((v,i)=>`<circle cx="${x(i)}" cy="${y(v)}" r="4" fill="#2563eb"/>`).join(""),xl=labels.map((l,i)=>`<text x="${x(i)}" y="${h-6}" text-anchor="middle" font-size="11" fill="#64748b">${esc(l)}</text>`).join("");return`<div class="svg-chart-wrap"><svg class="svg-chart" viewBox="0 0 ${w} ${h}">${grid}<polygon points="${area}" fill="rgba(34,197,94,.12)"></polygon><polyline points="${pts}" fill="none" stroke="#06b6d4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></polyline>${dots}${xl}<text x="4" y="18" font-size="11" fill="#64748b">${safe}${esc(o.suffix||"")}</text><text x="4" y="${p.top+ih}" font-size="11" fill="#64748b">${min}${esc(o.suffix||"")}</text></svg></div>`}
function bar(labels,values,o={}){const w=260,h=120,p={top:12,right:12,bottom:24,left:22},iw=w-p.left-p.right,ih=h-p.top-p.bottom,max=o.max||Math.max(...values,1),bw=iw/Math.max(values.length,1)*.56,step=iw/Math.max(values.length,1),bars=values.map((v,i)=>{const bh=(v/max)*ih,x=p.left+i*step+(step-bw)/2,y=p.top+ih-bh;return`<g><rect x="${x}" y="${y}" width="${bw}" height="${bh}" rx="8" fill="#38bdf8"></rect><text x="${x+bw/2}" y="${y-4}" text-anchor="middle" font-size="11" fill="#0f172a">${v}${esc(o.suffix||"")}</text><text x="${x+bw/2}" y="${h-6}" text-anchor="middle" font-size="11" fill="#64748b">${esc(labels[i])}</text></g>`}).join(""),grid=[0,.5,1].map(r=>`<line x1="${p.left}" y1="${p.top+ih*r}" x2="${p.left+iw}" y2="${p.top+ih*r}" stroke="#e2e8f0"/>`).join("");return`<div class="svg-chart-wrap"><svg class="svg-chart" viewBox="0 0 ${w} ${h}">${grid}${bars}<text x="4" y="18" font-size="11" fill="#64748b">${max}${esc(o.suffix||"")}</text></svg></div>`}
function metricCard(t,v,s,chart,cap=""){return`<article class="metric-graph-card"><h4>${t}</h4><div class="metric-value"><strong>${v}</strong><span>${s}</span></div>${chart}${cap?`<div class="chart-caption">${cap}</div>`:""}</article>`}
function hero(){const d=getChartData(),p=activePatient(),m=p.metrics,open=tasks.filter(t=>taskVisibleForCurrentUser(t)&&!t[3]).length,done=tasks.filter(t=>taskVisibleForCurrentUser(t)&&t[3]).length;return`<div class="metric-chart-grid">${metricCard("SpO₂",m.spo2,"laatste meting",line(chartLabels,d.saturatie,{min:86,max:97,suffix:"%"}),"Saturatie van de geselecteerde patiënt.")}${metricCard("FEV1",m.fev1,"longfunctie",line(chartLabels,d.fev1,{min:25,max:65,suffix:"%"}),"Longfunctie van de geselecteerde patiënt.")}${metricCard("Gewicht",m.weight,"voeding",line(chartLabels,d.gewicht,{min:60,max:86,suffix:" kg"}),"Gewichtstrend van de geselecteerde patiënt.")}${metricCard("Taken",`${open} open`,`${done} afgerond`,bar(["open","klaar"],[open,done],{max:Math.max(open,done,4)}),`Werkvoorraad bij ${p.shortName}.`)}</div><div class="chart-legend"><span><span class="legend-dot" style="background:#06b6d4"></span>Trendgrafiek</span><span><span class="legend-dot" style="background:#38bdf8"></span>Staafgrafiek</span></div>`}
function workflow(owner){return(dailyWorkflow[owner]||[]).map(s=>`<span class="pill">${s}</span>`).join("")}
function treatmentScope(){const p=activePatient();if(currentUser.loginKey==="huisarts")return`<section class="overview-section"><h3>Behandeloverzicht huisarts</h3><p class="instruction-line">De huisarts ziet de gehele behandeling van ${p.shortName}: eerstelijnszorg, specialistische terugkoppeling, verpleegkundige observaties en paramedische aandachtspunten.</p><div class="compact-two-column"><div><strong>Mag inzien/coördineren</strong><ul class="compact-list"><li>Risicosignalen en follow-up</li><li>Terugkoppeling longarts en longzorg</li><li>Open acties van alle betrokken disciplines</li><li>Berichten, overdracht en feedback</li></ul></div><div><strong>Niet bedoeld als</strong><ul class="compact-list"><li>Vervanging van specialistisch behandelbesluit</li><li>Vervanging van discipline-eigen rapportage</li></ul></div></div></section>`;if(currentUser.loginKey==="longarts")return`<section class="overview-section"><h3>Behandeloverzicht longarts</h3><p class="instruction-line">De longarts ziet de specialistische behandeling van ${p.shortName}: longfunctie, exacerbaties, specialistisch beleid, longzorg en relevante terugkoppeling van verpleegkundigen en paramedici.</p><div class="compact-two-column"><div><strong>Mag inzien/beoordelen</strong><ul class="compact-list"><li>Longfunctie, GOLD-classificatie en exacerbaties</li><li>Specialistische longzorg en verpleegkundige signalen</li><li>Relevante paramedische gegevens</li><li>Specialistisch advies en terugkoppeling naar huisarts</li></ul></div><div><strong>Begrenzing</strong><ul class="compact-list"><li>Geen totaalbeheer van eerstelijns follow-up</li><li>Geen toegang tot Gordon-opzet als eigen werkmodule</li></ul></div></div></section>`;return""}
function roleSummary(){if(currentUser.loginKey!=="huisarts"&&currentUser.loginKey!=="longarts")return"";const rows=accessibleDisciplineKeys().map(k=>{const d=getPatientDisciplineData(k),txt=d.cards.map(([t,v])=>`${t}: ${v}`).join(" · ");return`<div class="row"><strong>${disciplines[k].label}</strong><br>${d.role}<br><span class="muted">${txt}</span></div>`}).join("");return`<section class="overview-section"><h3>${currentUser.loginKey==="huisarts"?"Ketenoverzicht per discipline":"Specialistisch overzicht per discipline"}</h3><p class="instruction-line">Hierdoor is duidelijk dat ${currentUser.role} meer overzicht heeft dan een disciplinegebonden gebruiker.</p><div class="list">${rows}</div></section>`}
function renderOverview(){const d=getPatientDisciplineData(currentDiscipline),p=activePatient();let note="";if(currentUser.loginKey==="huisarts")note=`<div class="role-note"><strong>Huisarts-interface:</strong> totaaloverzicht over de gehele COPD-behandeling. De huisarts kan alle betrokken disciplines bekijken, acties bewaken en vervolgzorg uitzetten.</div>`;if(currentUser.loginKey==="longarts")note=`<div class="role-note"><strong>Longarts-interface:</strong> specialistisch behandeloverzicht. De longarts ziet longzorg, verpleegkundige signalen en relevante paramedische informatie voor specialistisch beleid.</div>`;if(currentUser.loginKey==="verpleegkundigen")note=`<div class="role-note"><strong>Verpleegkundigen-interface:</strong> eigen functies voor Gordon-opzet, verpleegkundige observaties, zorgcoördinatie, taken en overdracht.</div>`;const patient=d.cards.map(([t,v])=>`<li><strong>${t}:</strong> ${v}</li>`).join(""),actions=(stakeholderActions[currentUser.taskOwner]||[]).map(a=>`<li>${a}</li>`).join(""),open=tasks.filter(t=>taskVisibleForCurrentUser(t)&&!t[3]).slice(0,5).map(t=>`<li><strong>${t[0]} · ${t[2]}:</strong> ${t[1]}</li>`).join("")||`<li>Geen open taken binnen jouw overzicht bij ${p.shortName}.</li>`;panel(`Gecombineerd werkoverzicht — ${disciplines[currentDiscipline].label} — ${p.shortName}`,`<div class="single-overview-card">${note}<section class="overview-section"><h3>Snelbeeld + grafieken</h3><p class="instruction-line">Actuele waarden en trends van de geselecteerde patiënt.</p>${hero()}</section>${treatmentScope()}${roleSummary()}<section class="overview-section compact-two-column"><div><h3>Patiëntinformatie binnen gekozen discipline</h3><p class="instruction-line">Rol: ${d.role}</p><ul class="compact-list">${patient}</ul></div><div><h3>Mijn acties en taken</h3><ul class="compact-list">${actions}${open}</ul></div></section><section class="overview-section"><h3>Dagelijkse workflow</h3><p>${workflow(currentUser.taskOwner)}</p><div class="compact-actions"><button onclick="currentTab='acties';render()" class="secondary-button">Acties openen</button><button onclick="currentTab='dossier';render()" class="secondary-button">Dossier openen</button><button onclick="currentTab='nood';render()" class="emergency-action">🚨 Noodknop</button></div></section></div>`)}
function gordonVisuals(){const d=getChartData(),p=activePatient();return{"Gezondheidsbeleving":{type:"bar",title:"Exacerbaties",labels:["Q1","Q2","Q3","Q4"],values:p.diagnosis.includes("IV")?[1,2,4,5]:p.diagnosis.includes("II")?[0,0,1,1]:[0,1,1,3],max:5,note:"Exacerbaties zijn patiëntspecifiek."},"Voeding en metabolisme":{type:"line",title:"Gewichtstrend",labels:chartLabels,values:d.gewicht,min:60,max:86,suffix:" kg",note:"Gewichtstrend van de geselecteerde patiënt."},"Activiteit en beweging":{type:"line",title:"6MWT",labels:chartLabels,values:d.wandeltest,min:120,max:350,suffix:" m",note:"Inspanningstolerantie."},"Slaap en rust":{type:"bar",title:"Nachtelijke benauwdheid",labels:["jan","feb","mrt","apr"],values:p.diagnosis.includes("IV")?[2,3,4,5]:p.diagnosis.includes("II")?[0,1,1,1]:[1,1,2,3],max:5,suffix:"x",note:"Nachtelijke klachten."},"Zelfbeleving":{type:"bar",title:"Angstscore",labels:["laag","matig","hoog"],values:p.metrics.anxiety==="Hoog"?[1,2,5]:p.metrics.anxiety==="Laag"?[3,1,0]:[1,2,4],max:5,suffix:"/5",note:"Angst bij benauwdheid."},"Stress en coping":{type:"bar",title:"Coping",labels:["zelfmanagement","structuur","steun"],values:p.metrics.coping==="Kwetsbaar"?[1,3,4]:p.metrics.coping==="Goed"?[4,3,2]:[2,3,4],max:5,suffix:"/5",note:"Coping en ondersteuning."},"Rollen en relaties":{type:"bar",title:"Netwerk",labels:["patiënt","mantelzorger","ketenteam"],values:[3,4,4],max:5,suffix:"/5",note:"Betrokkenheid rond patiënt."}}}
function renderGordon(){const v=gordonVisuals(),p=activePatient(),rows=gordon.map(([title,txt])=>{const a=v[title];let visual="";if(a){const ch=a.type==="line"?line(a.labels,a.values,{min:a.min,max:a.max,suffix:a.suffix||""}):bar(a.labels,a.values,{max:a.max,suffix:a.suffix||""});visual=`<div class="gordon-visual"><strong>${a.title}</strong>${ch}<div class="gordon-note">${a.note}</div></div>`}return`<article class="gordon-item"><strong>${title}</strong><p>${txt}</p>${visual}</article>`}).join("");panel(`Gordon-opzet verpleegkundigen — ${p.shortName}`,`<p class="muted">Alleen zichtbaar voor verpleegkundigen. Gegevens en grafieken horen bij de geselecteerde patiënt.</p><div class="gordon-grid">${rows}</div>`)}
function getRecipients(){return["Huisarts","Longarts","Longzorg","Verpleegkundigen","Fysiotherapie","Diëtetiek","Psychologie","Praktijkondersteuner","Apotheker","Afdelingshoofd","ICT-beheerder"]}function recipientOptions(){return getRecipients().map(r=>`<option value="${r}">${r}</option>`).join("")}
function renderActionsCommunication(){const p=activePatient(),visible=tasks.map((task,index)=>({task,index})).filter(i=>taskVisibleForCurrentUser(i.task)),taskRows=visible.length?visible.map(({task,index})=>{const[o,txt,prio,done,pid]=task;return`<div class="task"><div><strong style="${done?'text-decoration:line-through;color:#94a3b8;':''}">${txt}</strong><p>Toegewezen aan: ${o} · Prioriteit: ${prio} · Patiënt: ${patients[pid]?.shortName||p.shortName}</p></div><button onclick="toggleTask(${index})">${done?"Heropenen":"Afronden"}</button></div>`}).join(""):`<div class="row">Er zijn geen open taken voor ${currentUser.role} bij ${p.shortName}.</div>`,assign=currentUser.canAssignTasks?`<label>Taak toewijzen aan zorgverlener</label><select id="taskOwner">${recipientOptions()}</select><label>Prioriteit</label><select id="taskPriority"><option>Laag</option><option selected>Middel</option><option>Hoog</option><option>Urgent</option></select><textarea id="taskInput" placeholder="Nieuwe taak voor de geselecteerde patiënt..."></textarea><button onclick="addTask()">Taak toevoegen</button>`:`<div class="demo-box"><strong>Mijn taken</strong><br>Je ziet hier alleen taken voor jouw rol en de geselecteerde patiënt.</div>`,msg=messages.map(([f,t,x])=>`<div class="message"><strong>${f} → ${t}</strong><p>${x}</p></div>`).join(""),fb=feedbackItems.map(([f,c,t])=>`<div class="row"><strong>${f} · ${c}</strong><br>${t}</div>`).join("");panel(`Acties & communicatie — ${currentUser.role} — ${p.shortName}`,`<div class="single-overview-card"><section class="overview-section"><h3>Taken</h3><p class="instruction-line">Huisarts ziet ketenacties; longarts specialistische acties; andere rollen eigen taken.</p>${assign}<div class="list">${taskRows}</div></section><section class="overview-section"><h3>Bericht of overdracht sturen</h3><label>Naar discipline/zorgverlener</label><select id="messageReceiver">${recipientOptions()}</select><textarea id="messageInput" placeholder="Typ een bericht of overdracht over de geselecteerde patiënt..."></textarea><button onclick="addMessage()">Bericht toevoegen</button><div class="list">${msg}</div></section><section class="overview-section"><h3>Feedback en verbeterpunten</h3><label>Categorie</label><select id="feedbackCategory"><option>Taakverdeling</option><option>Communicatie</option><option>Patiëntinformatie</option><option>Gebruiksgemak</option><option>Dagelijkse werkzaamheden</option><option>Techniek/beheer</option></select><textarea id="feedbackInput" placeholder="Typ hier een concreet verbeterpunt..."></textarea><button onclick="addFeedback()">Feedbackpunt toevoegen</button><div class="list">${fb}</div></section></div>`)}
function addTask(){const input=$("taskInput"),owner=$("taskOwner"),prio=$("taskPriority");if(!input||!owner||!prio)return;const txt=input.value.trim();if(!txt)return;tasks.unshift([owner.value,txt,prio.value,false,currentPatientId]);renderActionsCommunication()}function toggleTask(i){tasks[i][3]=!tasks[i][3];renderActionsCommunication()}function addMessage(){const input=$("messageInput"),rec=$("messageReceiver");if(!input||!rec)return;const txt=input.value.trim();if(!txt)return;messages.unshift([currentUser.role,rec.value,txt]);renderActionsCommunication()}function addFeedback(){const input=$("feedbackInput"),cat=$("feedbackCategory");if(!input||!cat)return;const txt=input.value.trim();if(!txt)return;feedbackItems.unshift([currentUser.role,cat.value,txt]);renderActionsCommunication()}
function renderDossier(){const d=getPatientDisciplineData(currentDiscipline),p=activePatient(),history=d.history.map(i=>`<div class="row">${i}</div>`).join(""),overview=(currentUser.loginKey==="huisarts"||currentUser.loginKey==="longarts")?`<section class="overview-section"><h3>${currentUser.loginKey==="huisarts"?"Keteninformatie huisarts":"Specialistische dossierinformatie longarts"}</h3><p class="instruction-line">Samenvatting van de disciplines die binnen jouw rol zichtbaar zijn.</p><div class="list">${accessibleDisciplineKeys().map(k=>{const data=getPatientDisciplineData(k);return`<div class="row"><strong>${disciplines[k].label}</strong><br>${data.history.join("<br>")}</div>`}).join("")}</div></section>`:"",needRows=needs.map(([a,b,c])=>`<tr><td><strong>${a}</strong></td><td>${b}</td><td>${c}</td></tr>`).join(""),lawRows=laws.map(([a,b,c])=>`<tr><td><strong>${a}</strong></td><td>${b}</td><td>${c}</td></tr>`).join("");panel(`Dossier & randvoorwaarden — ${p.shortName}`,`<div class="single-overview-card">${treatmentScope()}<section class="overview-section"><h3>Geschiedenis gekozen discipline</h3><p class="instruction-line">Patiëntspecifieke voorgeschiedenis en discipline-informatie.</p><div class="list">${history}</div></section>${overview}<section class="overview-section"><h3>Informatie- en instructiebehoefte</h3><table><thead><tr><th>Stakeholder</th><th>Informatiebehoefte</th><th>Instructiebehoefte</th></tr></thead><tbody>${needRows}</tbody></table></section><section class="overview-section"><h3>Wetgeving en privacy</h3><table><thead><tr><th>Aspect</th><th>Betekenis</th><th>Toepassing</th></tr></thead><tbody>${lawRows}</tbody></table></section></div>`)}
function renderEmergency(){const rows=emergencyLog.map(([f,t])=>`<div class="row"><strong>${f}</strong><br>${t}</div>`).join("");panel("Noodknop COPD",`<p class="muted">Deze demo-knop registreert snel een noodmelding. In een echte versie koppel je dit aan het spoedprotocol.</p><div class="alert">🚨 <strong>Noodscenario:</strong> plotselinge benauwdheid, lage saturatie of vermoeden van exacerbatie.</div><button class="emergency-action" onclick="triggerEmergency()">🚨 Start noodmelding</button><div class="quick-help"><div class="help-card"><strong>1. Controleer patiënt</strong><br>Saturatie, ademhaling, klachten en bewustzijn.</div><div class="help-card"><strong>2. Waarschuw juiste zorgverlener</strong><br>Huisarts, longarts, longzorg of spoedlijn.</div><div class="help-card"><strong>3. Leg actie vast</strong><br>Registreer melding, taak en overdracht.</div></div><h3>Demo-logboek noodmeldingen</h3><div class="list">${rows}</div>`)}function triggerEmergency(){const p=activePatient(),txt=`Noodmelding aangemaakt voor ${p.shortName}: lage saturatie/benauwdheid controleren en direct opvolgen.`;emergencyLog.unshift([currentUser.role,txt]);messages.unshift([currentUser.role,"Longzorg",`Noodmelding: ${p.shortName} heeft mogelijk acute benauwdheid. Graag directe opvolging.`]);tasks.unshift([currentUser.taskOwner,"Volg noodmelding COPD op en registreer vervolgactie","Urgent",false,currentPatientId]);renderEmergency()}
